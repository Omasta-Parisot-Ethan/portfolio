---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <script type="module" src="/js/main.js"></script>
  <!-- Hero Section -->
  <section class="relative w-full min-h-[550px] h-screen flex items-center justify-center overflow-hidden bg-[#232836] px-4 sm:px-6 md:px-12">

    <img 
      src="/photo_moi.png" 
      alt="Photo de moi" 
      class="absolute inset-0 w-full h-full object-cover opacity-80 z-0" 
      data-parallax 
      data-speed="0.18"
    />

    <div class="absolute inset-0 bg-[#232836] opacity-60 z-10"></div>

    <div
      class="absolute left-0 bottom-0 w-full h-[40vh] z-20 pointer-events-none"
      style="background: linear-gradient(to top, #232836 0%, rgba(35,40,54,0.8) 30%, rgba(35,40,54,0.4) 60%, transparent 100%);"
    ></div>

    <div class="relative z-30 flex flex-col items-center justify-center h-full -mt-8 sm:-mt-12 text-center max-w-[900px]">
      
      <h1
        class="font-semibold text-[#f5dbf7] mb-10 sm:mb-16 leading-tight"
        style="font-family: 'Inter', sans-serif; font-size: clamp(2rem, 5vw, 3rem);"
        data-reveal
      >
        Faire d’un message une narration<br /> qui engage et convainc
      </h1>

      <div class="mt-8 sm:mt-12 flex justify-center" data-reveal>
        <svg
          class="scroll-indicator"
          width="38"
          height="84"
          viewBox="0 0 38 84"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <rect x="2" y="2" width="34" height="80" rx="17" stroke="#E5E7EB" stroke-width="4" fill="none" />
          <circle class="scroll-dot" cx="19" cy="20" r="6" fill="#E5E7EB" />
        </svg>
      </div>

    </div>
  </section>

  <!-- About Section -->
  <section class="relative w-full flex items-center min-h-[520px] bg-[#232836] py-16 sm:py-24 px-4 sm:px-6 md:px-12">

    <div class="absolute right-0 top-0 h-full w-2/5 max-w-[55vw] z-0 overflow-hidden hidden sm:block">
      <img
        src="/photo_moi_2.png"
        alt="Photo présentation"
        class="h-full object-cover opacity-75 pointer-events-none"
        data-parallax
        data-speed="0.12"
      />
      <div
        class="absolute left-0 top-0 w-full h-[35vh] z-10 pointer-events-none"
        style="background: linear-gradient(to bottom, #232836 0%, rgba(35,40,54,0.8) 40%, rgba(35,40,54,0.3) 80%, transparent 100%);"
      ></div>
    </div>

    <div class="absolute inset-0 bg-[#232836] opacity-40 z-10"></div>

    <div class="relative z-20 max-w-xl sm:max-w-lg md:max-w-xl lg:max-w-2xl">

      <h2
        class="font-semibold text-[#f5dbf7] mb-6"
        style="font-family: 'Inter', sans-serif; font-size: clamp(2rem, 4vw, 3rem);"
        data-reveal
      >
        Me connaître
      </h2>

      <p
        class="text-[#f5dbf7] mb-12 leading-relaxed"
        style="font-family: 'Inter', sans-serif; font-size: clamp(1rem, 2vw, 1.125rem);"
        data-reveal
      >
        Je suis Ethan Omasta-Parisot, étudiant en communication passionné par la création de messages efficaces et
        impactants. Discipline, rigueur et organisation guident chacun de mes projets, où stratégie et originalité se
        rencontrent. Pour moi, la communication ne se limite pas à transmettre de l’information : elle crée du sens,
        suscite des émotions et tisse des liens.
      </p>

      <a
        href="/about"
        class="bg-[#e5e7eb] text-[#232836] font-semibold rounded-xl px-6 py-4 text-lg sm:text-xl shadow hover:bg-[#ffd6ff] transition w-fit"
        data-reveal
      >
        A propos
      </a>

    </div>
  </section>

  <!-- Projects Section -->
  <section class="w-full bg-[#232836] py-16 sm:py-20 px-4 sm:px-6 md:px-12">

    <h2
      class="font-semibold text-[#f5dbf7] mb-12 ml-3 sm:ml-6"
      style="font-family: 'Inter', sans-serif; font-size: clamp(2rem, 4vw, 3rem);"
      data-reveal
    >
      Mes projets
    </h2>

    <div class="max-w-6xl mx-auto">

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-10 mb-16">

        <!-- Project card 1 -->
        <div
          class="relative flex flex-col rounded-3xl overflow-hidden bg-[#30333b] shadow-md transition-transform hover:-translate-y-2 hover:shadow-2xl group items-center"
          data-reveal
        >
          <img
            src="/logo.png"
            alt="Logo project"
            class="w-full h-[220px] md:h-[395px] object-contain bg-[#232836] rounded-t-2xl"
          />
          <div
            class="flex-1 flex flex-col px-4 md:px-6 py-4 md:py-6 bg-gradient-to-b from-[#30333b]/60 to-[#343848] w-full"
          >
            <div
              class="font-semibold text-[#f5dbf7] mb-2"
              style="font-family: 'Inter', sans-serif; font-size: 1.2rem;"
            >
              Identité graphique personnelle
            </div>
            <p class="text-[#c3b4d7] mb-6" style="font-size: 1rem;">
              Mon logo, sous différentes formes et couleurs.
            </p>
            <a
              href="#"
              class="mt-auto bg-[#e5e7eb] text-[#232836] font-semibold rounded-xl px-4 md:px-6 py-2 md:py-3 text-sm md:text-base w-fit shadow transition hover:bg-[#ffd6ff]"
            >
              Voir la réalisation
            </a>
          </div>
        </div>

        <!-- Project card 2 -->
        <div
          class="relative flex flex-col rounded-3xl overflow-hidden bg-[#30333b] shadow-md transition-transform hover:-translate-y-2 hover:shadow-2xl group items-center"
          data-reveal
        >
          <img
            src="/cookit-up.png"
            alt="Cookit-UP project"
            class="w-full h-[220px] md:h-[395px] object-contain bg-[#232836] rounded-t-2xl"
          />
          <div
            class="flex-1 flex flex-col px-4 md:px-6 py-4 md:py-6 bg-gradient-to-b from-[#30333b]/60 to-[#343848] w-full"
          >
            <div
              class="font-semibold text-[#f5dbf7] mb-2"
              style="font-family: 'Inter', sans-serif; font-size: 1.2rem;"
            >
              Cookit-UP
            </div>
            <p class="text-[#c3b4d7] mb-6" style="font-size: 1rem;">
              Application web réalisée en équipe : solution pour une consommation plus saine.
            </p>
            <a
              href="#"
              class="mt-auto bg-[#e5e7eb] text-[#232836] font-semibold rounded-xl px-4 md:px-6 py-2 md:py-3 text-sm md:text-base w-fit shadow transition hover:bg-[#ffd6ff]"
            >
              Voir la réalisation
            </a>
          </div>
        </div>

        <!-- Project card 3 -->
        <div
          class="relative flex flex-col rounded-3xl overflow-hidden bg-[#30333b] shadow-md transition-transform hover:-translate-y-2 hover:shadow-2xl group items-center"
          data-reveal
        >
          <img
            src="/holovisio.png"
            alt="HoloVisio project"
            class="w-full h-[220px] md:h-[395px] object-contain bg-[#232836] rounded-t-2xl"
          />
          <div
            class="flex-1 flex flex-col px-4 md:px-6 py-4 md:py-6 bg-gradient-to-b from-[#30333b]/60 to-[#343848] w-full"
          >
            <div
              class="font-semibold text-[#f5dbf7] mb-2"
              style="font-family: 'Inter', sans-serif; font-size: 1.2rem;"
            >
              HoloVisio
            </div>
            <p class="text-[#c3b4d7] mb-6" style="font-size: 1rem;">
              Site web mobile-first imaginé autour d’une télévision du futur.
            </p>
            <a
              href="#"
              class="mt-auto bg-[#e5e7eb] text-[#232836] font-semibold rounded-xl px-4 md:px-6 py-2 md:py-3 text-sm md:text-base w-fit shadow transition hover:bg-[#ffd6ff]"
            >
              Voir la réalisation
            </a>
          </div>
        </div>

      </div>

      <div class="flex justify-center" data-reveal>
        <a
          href="/projects"
          class="bg-[#e5e7eb] text-[#232836] font-semibold rounded-xl px-8 sm:px-10 py-4 sm:py-5 text-lg sm:text-xl shadow transition hover:bg-[#ffd6ff]"
        >
          Découvrir plus de projets
        </a>
      </div>

    </div>
  </section>

  <!-- Skills Section -->
  <section class="w-full bg-[#232836] py-16 sm:py-24 px-4 sm:px-6 md:px-12">

    <h2
      class="font-semibold text-[#f5dbf7] mb-14 ml-3 sm:ml-6"
      style="font-family:'Inter',sans-serif; font-size: clamp(2rem, 4vw, 3rem);"
      data-reveal
    >
      Mes compétences
    </h2>

    <div class="max-w-7xl mx-auto grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-8 md:gap-16">

      <!-- Bloc 1 -->
      <div class="bg-[#30333b] rounded-3xl p-6 md:p-10 shadow-lg" data-reveal>
        <h3 class="text-[28px] md:text-[32px] font-semibold text-[#f5dbf7] mb-8">Communication & Organisation</h3>
        <div class="grid grid-cols-2 gap-6 md:gap-8">

          <div class="flex flex-col items-center text-center">
            <img src="/excel.png" width="90" height="85" alt="Excel" />
            <p class="text-[#f5dbf7] mt-3 font-medium">Excel</p>
            <span class="text-[#c3b4d7] text-sm md:text-[15px]">Intermédiaire</span>
          </div>
          <div class="flex flex-col items-center text-center">
            <img src="/miro.png" width="90" height="90" alt="Miro" />
            <p class="text-[#f5dbf7] mt-3 font-medium">Miro</p>
            <span class="text-[#c3b4d7] text-sm md:text-[15px]">Avancé</span>
          </div>
          <div class="flex flex-col items-center text-center">
            <img src="/jira.png" width="90" height="90" alt="Jira" />
            <p class="text-[#f5dbf7] mt-3 font-medium">Jira</p>
            <span class="text-[#c3b4d7] text-sm md:text-[15px]">Intermédiaire</span>
          </div>
          <div class="flex flex-col items-center text-center">
            <img src="/trello.png" width="90" height="90" alt="Trello" />
            <p class="text-[#f5dbf7] mt-3 font-medium">Trello</p>
            <span class="text-[#c3b4d7] text-sm md:text-[15px]">Avancé</span>
          </div>
          <div class="flex flex-col items-center text-center">
            <img src="/notion.png" width="90" height="90" alt="Notion" />
            <p class="text-[#f5dbf7] mt-3 font-medium">Notion</p>
            <span class="text-[#c3b4d7] text-sm md:text-[15px]">Avancé</span>
          </div>
          <div class="flex flex-col items-center text-center">
            <img src="/google_drive.png" width="90" height="80" alt="Google Drive" />
            <p class="text-[#f5dbf7] mt-3 font-medium">Google Drive</p>
            <span class="text-[#c3b4d7] text-sm md:text-[15px]">Avancé</span>
          </div>

          <div class="flex flex-col items-center text-center col-span-2">
            <img src="/toms_planner.png" width="160" height="85" alt="Tom's Planner" />
            <p class="text-[#f5dbf7] mt-3 font-medium">Tom's Planner</p>
            <span class="text-[#c3b4d7] text-sm md:text-[15px]">Intermédiaire</span>
          </div>

        </div>
      </div>

      <!-- Bloc 2 -->
      <div class="bg-[#30333b] rounded-3xl p-6 md:p-10 shadow-lg" data-reveal>
        <h3 class="text-[28px] md:text-[32px] font-semibold text-[#f5dbf7] mb-8">Développement & Web</h3>
        <div class="grid grid-cols-2 gap-6 md:gap-8">
          
          <div class="flex flex-col items-center text-center">
            <img src="/github2.png" width="90" height="90" alt="Github" />
            <p class="text-[#f5dbf7] mt-3 font-medium">Github</p>
            <span class="text-[#c3b4d7] text-sm md:text-[15px]">Intermédiaire</span>
          </div>

          <div class="flex flex-col items-center text-center">
            <img src="/astro.png" width="90" height="90" alt="Astro" />
            <p class="text-[#f5dbf7] mt-3 font-medium">Astro</p>
            <span class="text-[#c3b4d7] text-sm md:text-[15px]">Intermédiaire</span>
          </div>

          <div class="flex flex-col items-center text-center">
            <img src="/tailwind.png" width="90" height="55" alt="Tailwind" />
            <p class="text-[#f5dbf7] mt-3 font-medium">Tailwind CSS</p>
            <span class="text-[#c3b4d7] text-sm md:text-[15px]">Intermédiaire</span>
          </div>

          <div class="flex flex-col items-center text-center">
            <img src="/html.png" width="90" height="90" alt="HTML" />
            <p class="text-[#f5dbf7] mt-3 font-medium">HTML</p>
            <span class="text-[#c3b4d7] text-sm md:text-[15px]">Avancé</span>
          </div>

          <div class="flex flex-col items-center text-center">
            <img src="/css.png" width="65" height="90" alt="CSS" />
            <p class="text-[#f5dbf7] mt-3 font-medium">CSS</p>
            <span class="text-[#c3b4d7] text-sm md:text-[15px]">Intermédiaire</span>
          </div>

          <div class="flex flex-col items-center text-center">
            <img src="/wordpress.png" width="180" height="120" alt="Wordpress" />
            <p class="text-[#f5dbf7] mt-3 font-medium">Wordpress</p>
            <span class="text-[#c3b4d7] text-sm md:text-[15px]">Intermédiaire</span>
          </div>

        </div>
      </div>

      <!-- Bloc 3 -->
      <div class="bg-[#30333b] rounded-3xl p-6 md:p-10 shadow-lg" data-reveal>
        <h3 class="text-[28px] md:text-[32px] font-semibold text-[#f5dbf7] mb-8">Création visuelle</h3>
        <div class="grid grid-cols-2 gap-6 md:gap-8">

          <div class="flex flex-col items-center text-center">
            <img src="/figma.png" width="220" height="220" alt="Figma" />
            <p class="text-[#f5dbf7] mt-3 font-medium">Figma</p>
            <span class="text-[#c3b4d7] text-sm md:text-[15px]">Avancé</span>
          </div>

          <div class="flex flex-col items-center text-center">
            <img src="/illustrator.png" width="90" height="90" alt="Adobe Illustrator" />
            <p class="text-[#f5dbf7] mt-3 font-medium">Illustrator</p>
            <span class="text-[#c3b4d7] text-sm md:text-[15px]">Débutant</span>
          </div>

          <div class="flex flex-col items-center text-center">
            <img src="/davinci_resolve.png" width="90" height="90" alt="Davinci Resolve" />
            <p class="text-[#f5dbf7] mt-3 font-medium">DaVinci Resolve</p>
            <span class="text-[#c3b4d7] text-sm md:text-[15px]">Intermédiaire</span>
          </div>

          <div class="flex flex-col items-center text-center">
            <img src="/chatgpt.png" width="90" height="90" alt="ChatGPT" />
            <p class="text-[#f5dbf7] mt-3 font-medium">Intelligence Artificielle</p>
            <span class="text-[#c3b4d7] text-sm md:text-[15px]">Avancé</span>
          </div>

        </div>
      </div>

    </div>

    <div class="flex justify-center mt-12 md:mt-16 w-full" data-reveal>
      <a
        href="/contact"
        class="bg-[#e5e7eb] text-[#232836] font-semibold rounded-xl px-8 py-4 text-lg sm:text-xl shadow transition hover:bg-[#ffd6ff]"
      >
        Contactez-moi
      </a>
    </div>

  </section>

  <style>
    .scroll-dot {
      animation: dot-scroll-move 1.5s cubic-bezier(0.7, 0, 0.3, 1) infinite;
    }
    @keyframes dot-scroll-move {
      0% { cy: 20; opacity: 1; }
      60% { cy: 65; opacity: 1; }
      80% { cy: 65; opacity: 0; }
      100% { cy: 20; opacity: 0; }
    }
  </style>

</Layout>
