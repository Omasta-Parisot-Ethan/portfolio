---
// Illustrations SVG schématiques des projets (reprises de src/components/Projects.astro)
interface Props { id: string; }
const { id } = Astro.props;
---

{id === 'vitra' && (
<svg viewBox="0 0 640 400" class="pv-svg w-full h-full" role="img" aria-label="Illustration abstraite de cartographie et système de navigation pour le projet Vitra">
<rect width="640" height="400" fill="#fffaff" />
<g class="pv-grid" stroke="#232836" stroke-opacity="0.12" stroke-width="1">
<line x1="80" y1="0" x2="80" y2="400" />
<line x1="160" y1="0" x2="160" y2="400" />
<line x1="240" y1="0" x2="240" y2="400" />
<line x1="320" y1="0" x2="320" y2="400" />
<line x1="400" y1="0" x2="400" y2="400" />
<line x1="480" y1="0" x2="480" y2="400" />
<line x1="560" y1="0" x2="560" y2="400" />
<line x1="0" y1="80" x2="640" y2="80" />
<line x1="0" y1="160" x2="640" y2="160" />
<line x1="0" y1="240" x2="640" y2="240" />
<line x1="0" y1="320" x2="640" y2="320" />
</g>
<rect class="pv-zone" style="--i:0" x="60" y="55" width="170" height="120" fill="#f5dbf7" stroke="#232836" stroke-width="2.5" />
<rect class="pv-zone" style="--i:1" x="280" y="85" width="140" height="140" fill="#232836" />
<rect class="pv-zone" style="--i:2" x="460" y="55" width="120" height="180" fill="#e8bce9" stroke="#232836" stroke-width="2.5" />
<rect class="pv-zone" style="--i:3" x="110" y="235" width="220" height="110" fill="#fffaff" stroke="#232836" stroke-width="2.5" />
<path class="pv-route"
d="M 145 115 L 350 155 L 520 145 L 220 290"
fill="none"
stroke="#232836"
stroke-width="3.5"
stroke-dasharray="8 6"
/>
<rect class="pv-node" style="--i:0" x="133" y="103" width="24" height="24" fill="#232836" />
<rect class="pv-node" style="--i:1" x="338" y="143" width="24" height="24" fill="#e8bce9" stroke="#fffaff" stroke-width="2" />
<rect class="pv-node" style="--i:2" x="508" y="133" width="24" height="24" fill="#fffaff" stroke="#232836" stroke-width="2.5" />
<rect class="pv-node" style="--i:3" x="208" y="278" width="24" height="24" fill="#232836" />
<g class="pv-label">
<rect x="75" y="70" width="65" height="22" fill="#232836" />
<text x="84" y="85" fill="#fffaff" font-family="monospace" font-size="11">ZONE A1</text>
<text x="298" y="120" fill="#f5dbf7" font-family="monospace" font-size="11">REPÈRE CENTRAL</text>
<text x="130" y="265" fill="#232836" font-family="monospace" font-weight="bold" font-size="12">PARCOURS AUTONOME // 01</text>
</g>
</svg>
)}

{id === 'festivete' && (
<svg viewBox="0 0 640 400" class="pv-svg w-full h-full" role="img" aria-label="Composition d'affiche géométrique et événementielle pour le projet Bocksons Festival">
<rect width="640" height="400" fill="#f5dbf7" />
<g class="pv-decl" style="--i:0">
<rect x="330" y="50" width="265" height="145" fill="#fffaff" stroke="#232836" stroke-width="2.5" />
<rect x="350" y="70" width="75" height="105" fill="#e8bce9" stroke="#232836" stroke-width="2" />
<text x="445" y="98" fill="#232836" font-family="monospace" font-weight="bold" font-size="13">SYSTÈME D’AFFICHE</text>
<text x="445" y="122" fill="#232836" font-family="monospace" font-size="11">GRILLE MODULAIRE</text>
<rect x="445" y="140" width="120" height="24" fill="#232836" />
</g>
<g class="pv-decl" style="--i:1">
<rect x="330" y="220" width="265" height="145" fill="#e8bce9" stroke="#232836" stroke-width="2.5" />
<rect x="350" y="242" width="48" height="48" fill="#232836" />
<rect x="410" y="242" width="48" height="48" fill="#fffaff" stroke="#232836" stroke-width="2" />
<rect x="470" y="242" width="100" height="48" fill="#232836" />
<text x="350" y="325" fill="#232836" font-family="monospace" font-weight="bold" font-size="12">SIGNALÉTIQUE &amp; PROGRAMME</text>
</g>
<g class="pv-poster" style="">
<rect x="45" y="35" width="250" height="330" fill="#232836" />
<rect x="65" y="55" width="210" height="130" fill="#e8bce9" />
<rect class="pv-tile" style="--i:0" x="85" y="75" width="45" height="45" fill="#232836" />
<rect class="pv-tile" style="--i:1" x="140" y="75" width="45" height="45" fill="#fffaff" />
<rect class="pv-tile" style="--i:2" x="195" y="75" width="60" height="90" fill="#232836" />
<rect class="pv-tile" style="--i:3" x="85" y="130" width="100" height="35" fill="#f5dbf7" />
<text x="65" y="225" fill="#fffaff" font-family="sans-serif" font-weight="bold" font-size="20">Bocksons Festival</text>
<text x="65" y="252" fill="#e8bce9" font-family="monospace" font-size="12">ÉDITION CULTURELLE // PRINT</text>
<line x1="65" y1="272" x2="275" y2="272" stroke="#f5dbf7" stroke-width="1.5" />
<rect x="65" y="290" width="95" height="50" fill="#fffaff" />
<rect x="175" y="290" width="100" height="50" fill="#e8bce9" />
</g>
</svg>
)}

{id === 'formats-numeriques' && (
<svg viewBox="0 0 640 400" class="pv-svg w-full h-full" role="img" aria-label="Système de gabarits éditoriaux et formats numériques modulaires">
<rect width="640" height="400" fill="#fffaff" />
<g class="pv-fmt" style="--i:0;--r:-9deg">
<rect x="40" y="45" width="170" height="310" fill="#232836" />
<rect x="56" y="65" width="138" height="138" fill="#f5dbf7" />
<rect x="74" y="83" width="46" height="46" fill="#232836" />
<rect x="56" y="220" width="110" height="14" fill="#e8bce9" />
<rect x="56" y="246" width="138" height="8" fill="#fffaff" fill-opacity="0.6" />
<rect x="56" y="264" width="95" height="8" fill="#fffaff" fill-opacity="0.6" />
<text x="56" y="325" fill="#f5dbf7" font-family="monospace" font-size="11">FORMAT 01 // STORY</text>
</g>
<g class="pv-fmt" style="--i:1;--r:5deg">
<rect x="235" y="45" width="170" height="170" fill="#e8bce9" stroke="#232836" stroke-width="2.5" />
<rect x="255" y="65" width="130" height="75" fill="#fffaff" stroke="#232836" stroke-width="2" />
<text x="255" y="168" fill="#232836" font-family="monospace" font-weight="bold" font-size="12">CARROUSEL 1:1</text>
<text x="255" y="190" fill="#232836" font-family="monospace" font-size="11">GRILLE ÉDITORIALE</text>
<rect x="235" y="235" width="170" height="120" fill="#f5dbf7" stroke="#232836" stroke-width="2.5" />
<rect x="255" y="255" width="36" height="36" fill="#232836" />
<text x="305" y="278" fill="#232836" font-family="monospace" font-weight="bold" font-size="12">SYNTHÈSE</text>
<rect x="255" y="308" width="130" height="22" fill="#232836" />
</g>
<g class="pv-fmt" style="--i:2;--r:10deg">
<rect x="430" y="45" width="170" height="310" fill="#fffaff" stroke="#232836" stroke-width="2.5" />
<rect x="448" y="65" width="134" height="28" fill="#232836" />
<rect x="448" y="108" width="134" height="110" fill="#e8bce9" stroke="#232836" stroke-width="2" />
<rect x="448" y="234" width="134" height="55" fill="#f5dbf7" stroke="#232836" stroke-width="1.5" />
<text x="448" y="325" fill="#232836" font-family="monospace" font-size="11">FORMAT 03 // WEB</text>
</g>
</svg>
)}
